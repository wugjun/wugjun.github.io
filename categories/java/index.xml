<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Java on 补漏砖匠</title><link>/categories/java/</link><description>Recent content in Java on 补漏砖匠</description><generator>Hugo</generator><language>zh-cn</language><lastBuildDate>Fri, 19 Jun 2026 00:00:00 +0000</lastBuildDate><atom:link href="/categories/java/index.xml" rel="self" type="application/rss+xml"/><item><title>ThreadLocal 实现原理可视化</title><link>/%E7%BC%96%E7%A8%8B%E8%AF%AD%E8%A8%80/%E7%BC%96%E7%A8%8B%E8%AF%AD%E8%A8%80-ThreadLocal/</link><pubDate>Fri, 19 Jun 2026 00:00:00 +0000</pubDate><guid>/%E7%BC%96%E7%A8%8B%E8%AF%AD%E8%A8%80/%E7%BC%96%E7%A8%8B%E8%AF%AD%E8%A8%80-ThreadLocal/</guid><description>&lt;div class="tl-page"&gt;
&lt;h1&gt;🧵 ThreadLocal 实现内幕&lt;/h1&gt;
&lt;p class="tl-subtitle"&gt;全局共享 vs 线程私有 · 开放寻址 · 黄金分割哈希&lt;/p&gt;

&lt;!-- Part 1: 两种设计对比 --&gt;
&lt;div class="tl-grid"&gt;
 &lt;div class="tl-card"&gt;
 &lt;div class="tl-card-title"&gt;
 🌐 全局共享 Map
 &lt;span class="tl-badge tl-badge-old"&gt;早期设计&lt;/span&gt;
 &lt;/div&gt;
 &lt;ul&gt;
 &lt;li&gt;单个 &lt;code&gt;ThreadLocal&lt;/code&gt; 持有全局 &lt;code&gt;Map&amp;lt;Thread, T&amp;gt;&lt;/code&gt;&lt;/li&gt;
 &lt;li&gt;所有线程用同一张表，Key 为线程引用&lt;/li&gt;
 &lt;li&gt;多线程读写 &lt;strong&gt;必须加锁 / CAS&lt;/strong&gt;&lt;/li&gt;
 &lt;li&gt;线程死亡后，Entry 仍残留在 Map 中 → 可能内存泄漏&lt;/li&gt;
 &lt;/ul&gt;
 &lt;div class="tl-warning"&gt;⚠️ 全局竞争 + 跨核 Cache 乒乓&lt;/div&gt;
 &lt;/div&gt;

 &lt;div class="tl-card"&gt;
 &lt;div class="tl-card-title"&gt;
 🧩 线程私有 Map
 &lt;span class="tl-badge tl-badge-new"&gt;JDK 8+&lt;/span&gt;
 &lt;/div&gt;
 &lt;ul&gt;
 &lt;li&gt;每个线程持有自己的 &lt;code&gt;ThreadLocalMap&lt;/code&gt;&lt;/li&gt;
 &lt;li&gt;Key 为 &lt;code&gt;ThreadLocal&lt;/code&gt; 实例，Value 为存储值&lt;/li&gt;
 &lt;li&gt;&lt;strong&gt;零同步&lt;/strong&gt;：各线程只读自己的 Map&lt;/li&gt;
 &lt;li&gt;线程死亡 → 整个 Map 及 value 一次性回收&lt;/li&gt;
 &lt;li&gt;访问路径：&lt;code&gt;currentThread().threadLocals&lt;/code&gt;，一次字段读取&lt;/li&gt;
 &lt;/ul&gt;
 &lt;div class="tl-success"&gt;✅ 无锁、缓存友好、生命周期自然绑定&lt;/div&gt;
 &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Mermaid: 设计对比 --&gt;
&lt;div class="tl-card tl-card-full"&gt;
 &lt;div class="tl-card-title"&gt;📊 设计对比流程图&lt;/div&gt;
 &lt;div class="mermaid-wrapper"&gt;
&lt;pre class="mermaid"&gt;
flowchart LR
 subgraph Global["全局共享 Map"]
 direction TB
 TL[ThreadLocal 实例] --&gt; GMap[全局 Map]
 GMap --&gt; |Thread-1| V1[value1]
 GMap --&gt; |Thread-2| V2[value2]
 GMap --&gt; |Thread-N| VN[valueN]
 end

 subgraph ThreadLocal["线程私有 Map"]
 direction TB
 T1[Thread-1] --&gt; M1[ThreadLocalMap]
 M1 --&gt; |TL实例| A[value1]
 T2[Thread-2] --&gt; M2[ThreadLocalMap]
 M2 --&gt; |TL实例| B[value2]
 TN[Thread-N] --&gt; MN[ThreadLocalMap]
 MN --&gt; |TL实例| C[valueN]
 end
&lt;/pre&gt;
 &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Part 2: 开放寻址 + 线性探测 --&gt;
&lt;div class="tl-card tl-card-full"&gt;
 &lt;div class="tl-card-title"&gt;
 🔍 开放寻址 + 线性探测
 &lt;span class="tl-badge tl-badge-hash"&gt;Open Addressing&lt;/span&gt;
 &lt;/div&gt;
 &lt;ul&gt;
 &lt;li&gt;&lt;strong&gt;不使用&lt;/strong&gt; 红黑树或链表（Entry 数量预期极少）&lt;/li&gt;
 &lt;li&gt;冲突后顺数组向后找空槽，&lt;strong&gt;缓存行友好&lt;/strong&gt;，优于指针追溯&lt;/li&gt;
 &lt;li&gt;Entry 结构轻量，无额外指针开销&lt;/li&gt;
 &lt;/ul&gt;

 &lt;div class="tl-section-label"&gt;插入示例：&lt;code&gt;hash(txStatus) &amp;amp; 7 = 3&lt;/code&gt;&lt;/div&gt;
 &lt;div class="slot-row"&gt;
 &lt;div class="slot-wrapper"&gt;&lt;div class="slot slot-empty"&gt;0&lt;/div&gt;&lt;/div&gt;
 &lt;div class="slot-wrapper"&gt;&lt;div class="slot slot-empty"&gt;1&lt;/div&gt;&lt;/div&gt;
 &lt;div class="slot-wrapper"&gt;&lt;div class="slot slot-empty"&gt;2&lt;/div&gt;&lt;/div&gt;
 &lt;div class="slot-wrapper"&gt;&lt;div class="slot slot-used"&gt;3&lt;/div&gt;&lt;/div&gt;
 &lt;div class="slot-wrapper"&gt;&lt;div class="slot slot-used"&gt;4&lt;/div&gt;&lt;/div&gt;
 &lt;div class="slot-wrapper"&gt;&lt;div class="slot slot-hit"&gt;5&lt;/div&gt;&lt;/div&gt;
 &lt;div class="slot-wrapper"&gt;&lt;div class="slot slot-empty"&gt;6&lt;/div&gt;&lt;/div&gt;
 &lt;div class="slot-wrapper"&gt;&lt;div class="slot slot-empty"&gt;7&lt;/div&gt;&lt;/div&gt;
 &lt;/div&gt;
 &lt;div class="slot-desc"&gt;
 &lt;span&gt;⬅️ 初始 hash = 3，冲突&lt;/span&gt;
 &lt;span&gt;➡️ 探测 4，也冲突&lt;/span&gt;
 &lt;span&gt;➡️ 最终落入 5 ✅&lt;/span&gt;
 &lt;/div&gt;

 &lt;div class="mermaid-wrapper"&gt;
&lt;pre class="mermaid"&gt;
flowchart LR
 A["hash &amp; 7 = 3"] --&gt; B{槽位3?}
 B --&gt;|占用| C{槽位4?}
 C --&gt;|占用| D["槽位5 空闲"]
 D --&gt; E["✅ 插入成功"]
&lt;/pre&gt;
 &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Part 3: 黄金分割哈希 --&gt;
&lt;div class="tl-card tl-card-full"&gt;
 &lt;div class="tl-card-title"&gt;
 ✨ 魔数 &lt;code&gt;0x61c88647&lt;/code&gt;
 · 黄金比例
 &lt;span class="tl-badge tl-badge-hash"&gt;Fibonacci Hash&lt;/span&gt;
 &lt;/div&gt;
 &lt;div class="highlight-box"&gt;
 &lt;code&gt;private static final int HASH_INCREMENT = 0x61c88647;&lt;/code&gt;&lt;br&gt;
 &lt;code&gt;// 2^32 * 0.618 ≈ 1640531527&lt;/code&gt;
 &lt;/div&gt;
 &lt;ul&gt;
 &lt;li&gt;每个新 &lt;code&gt;ThreadLocal&lt;/code&gt; 的 hash 按此递增：&lt;code&gt;nextHashCode += HASH_INCREMENT&lt;/code&gt;&lt;/li&gt;
 &lt;li&gt;容量为 16 时，低 4 位等价于每次 +7（因 7 与 16 互质）&lt;/li&gt;
 &lt;li&gt;16 次插入恰好不重复地走遍全部槽位，避免冲突&lt;/li&gt;
 &lt;/ul&gt;

 &lt;div class="tl-section-label"&gt;序列示例（容量 16）：&lt;/div&gt;
 &lt;div id="seqContainer"&gt;&lt;/div&gt;

 &lt;div class="highlight-box tl-highlight-blue"&gt;
 &lt;code&gt;+7 回绕：14 + 7 = 21 → 21 mod 16 = 5&lt;/code&gt;
 &amp;nbsp; 连续分配天然均匀散开，探测序列最短
 &lt;/div&gt;

 &lt;div class="tl-sequence-path"&gt;
 &lt;strong&gt;序列：&lt;/strong&gt;
 0 → 7 → 14 → 5 → 12 → 3 → 10 → 1 → 8 → 15 → 6 → 13 → 4 → 11 → 2 → 9
 &lt;br&gt;&lt;span style="color:#64748b;"&gt;走遍全部 16 槽位，无碰撞&lt;/span&gt;
 &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Part 4: 额外要点 --&gt;
&lt;div class="tl-grid"&gt;
 &lt;div class="tl-card"&gt;
 &lt;div class="tl-card-title"&gt;⚡ 零同步 · 缓存友好&lt;/div&gt;
 &lt;ul&gt;
 &lt;li&gt;线程只读自己的 Map，&lt;strong&gt;不存在竞争路径&lt;/strong&gt;&lt;/li&gt;
 &lt;li&gt;若用全局 Map&amp;lt;Thread,T&amp;gt;，则必须加入并发控制（锁/CAS）&lt;/li&gt;
 &lt;li&gt;访问路径仅 &lt;code&gt;currentThread().threadLocals&lt;/code&gt;，无哈希查找&lt;/li&gt;
 &lt;li&gt;避免跨核缓存一致性开销&lt;/li&gt;
 &lt;/ul&gt;
 &lt;/div&gt;
 &lt;div class="tl-card"&gt;
 &lt;div class="tl-card-title"&gt;♻️ 生命周期 · 内存安全&lt;/div&gt;
 &lt;ul&gt;
 &lt;li&gt;线程死亡 → Thread 对象不可达 → 整个 Map 及所有 value 一次性回收&lt;/li&gt;
 &lt;li&gt;数据生命周期&lt;strong&gt;天然绑定线程&lt;/strong&gt;，而非绑定可能永生的静态字段&lt;/li&gt;
 &lt;li&gt;消除手动清理 &lt;code&gt;remove()&lt;/code&gt; 的遗忘风险&lt;/li&gt;
 &lt;/ul&gt;
 &lt;/div&gt;
&lt;/div&gt;

&lt;hr&gt;
&lt;div class="tl-footnote"&gt;
 ⚡ 基于 JDK 8+ ThreadLocal 实现 &amp;nbsp;·&amp;nbsp; 可视化仅供学习参考
&lt;/div&gt;
&lt;/div&gt;

&lt;!-- JS: 生成序列网格 --&gt;
&lt;script&gt;
(function () {
 var container = document.getElementById('seqContainer');
 if (!container) return;
 var n = 16, inc = 7, val = 0;
 var seq = [];
 for (var i = 0; i &lt; n; i++) { seq.push(val); val = (val + inc) % n; }

 var grid = document.createElement('div');
 grid.style.display = 'grid';
 grid.style.gridTemplateColumns = 'repeat(8, 1fr)';
 grid.style.gap = '0.5rem';
 grid.style.margin = '1rem 0';

 seq.forEach(function (v, idx) {
 var div = document.createElement('div');
 div.style.background = '#f8fafc';
 div.style.borderRadius = '10px';
 div.style.padding = '0.6rem 0.3rem';
 div.style.textAlign = 'center';
 div.style.fontSize = '0.85rem';
 div.style.border = '1px solid #e2e8f0';
 div.style.transition = 'background 0.2s';

 var label = document.createElement('div');
 label.style.color = '#64748b';
 label.style.fontSize = '0.65rem';
 label.textContent = '#' + idx;

 var value = document.createElement('div');
 value.style.fontWeight = '600';
 value.style.color = '#0f172a';
 value.textContent = v;

 // 高亮前几个关键值
 if ([0, 7, 14, 5, 12, 13].indexOf(v) !== -1) {
 div.style.background = '#dbeafe';
 div.style.borderColor = '#3b82f6';
 }

 div.appendChild(label);
 div.appendChild(value);
 grid.appendChild(div);
 });

 container.appendChild(grid);
})();
&lt;/script&gt;

&lt;!-- Mermaid --&gt;
&lt;script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"&gt;&lt;/script&gt;
