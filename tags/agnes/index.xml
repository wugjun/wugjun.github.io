<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Agnes on 补漏砖匠</title><link>/tags/agnes/</link><description>Recent content in Agnes on 补漏砖匠</description><generator>Hugo</generator><language>zh-cn</language><lastBuildDate>Thu, 18 Jun 2026 00:00:00 +0000</lastBuildDate><atom:link href="/tags/agnes/index.xml" rel="self" type="application/rss+xml"/><item><title>claude code教程安装</title><link>/%E5%B7%A5%E5%85%B7%E6%95%88%E7%8E%87/Claude-code/</link><pubDate>Thu, 18 Jun 2026 00:00:00 +0000</pubDate><guid>/%E5%B7%A5%E5%85%B7%E6%95%88%E7%8E%87/Claude-code/</guid><description>&lt;p&gt;&lt;a href="/%E5%B7%A5%E5%85%B7%E6%95%88%E7%8E%87/%E5%B7%A5%E5%85%B7%E6%95%88%E7%8E%87-%E6%B3%95%E5%AE%9D%E7%AF%87/"&gt;◀ 返回&lt;/a&gt;&lt;/p&gt;
&lt;h1 id="claude-code-替代品"&gt;claude code 替代品&lt;/h1&gt;
&lt;ol&gt;
&lt;li&gt;安装 claude&lt;/li&gt;
&lt;/ol&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;"&gt;&lt;code class="language-bash" data-lang="bash"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;npm install -g @anthropic-ai/claude-code
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;claude --version &lt;span style="color:#75715e"&gt;# 查看版本&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;ol start="2"&gt;
&lt;li&gt;
&lt;p&gt;安装 CC switch (&lt;a href="https://ccswitch.io/zh/"&gt;https://ccswitch.io/zh/&lt;/a&gt;)&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;获取 agnes api-key 有免费版本 &lt;a href="https://platform.agnes-ai.com/settings/apiKeys"&gt;https://platform.agnes-ai.com/settings/apiKeys&lt;/a&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;在 CC Switch 新增 agnes 模型填写&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;ul&gt;
&lt;li&gt;
&lt;p&gt;api-key:(&lt;strong&gt;****&lt;/strong&gt;),&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;请求地址(&lt;a href="https://apihub.agnes-ai.com/v1"&gt;https://apihub.agnes-ai.com/v1&lt;/a&gt;)&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;高级选项 -&amp;gt; api 格式选择需开启路由&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;模型映射，点击获取模型列表，将获取的模型列表在最右边下拉选择，做好选择agnes-2.0-flash 免费版本。点击支持 1M&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;保存配置后，需要 设置路由开关，在 CC Switch 软件的左上方锯齿按钮设置，选择路由页签，点击本地路由，将路开开关打开，路由启用选择Claude.&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;ol start="5"&gt;
&lt;li&gt;
&lt;p&gt;在命令窗口就可以使用claude了&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;在 Trae 中安装 claude code 插件就可以 使用 claude code Ai助手编程了&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;hr&gt;
&lt;p&gt;&lt;a href="/%E5%B7%A5%E5%85%B7%E6%95%88%E7%8E%87/%E5%B7%A5%E5%85%B7%E6%95%88%E7%8E%87-%E6%B3%95%E5%AE%9D%E7%AF%87/"&gt;◀ 返回&lt;/a&gt;&lt;/p&gt;</description></item></channel></rss>