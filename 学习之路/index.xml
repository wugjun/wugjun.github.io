&lt;title&gt;数字星夜 · 一年级数学 20 以内加减法 · Three.js 3D 游戏&lt;/title&gt;
&lt;style&gt;
 html,body{margin:0;padding:0;overflow:hidden;background:#0a0e1f;font-family:"PingFang SC","Microsoft YaHei",sans-serif;user-select:none;-webkit-user-select:none}
 #sceneWrap{position:fixed;inset:0;z-index:0}
 #sceneWrap canvas{display:block}
 #hud{position:fixed;top:0;left:0;right:0;z-index:20;pointer-events:none;padding:10px 14px;display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
 #hudTopL{display:flex;gap:10px;align-items:center}
 .pill{background:rgba(10,14,31,.72);border:1px solid rgba(255,255,255,.22);color:#ffe9b8;border-radius:999px;padding:6px 14px;font-size:16px;font-weight:700;backdrop-filter:blur(4px)}
 .pill b{color:#ffd75e}
 #backBtn{pointer-events:auto;background:#2f3b68;color:#fff;border:1px solid #5b6fc0;border-radius:10px;padding:8px 14px;font-size:15px;font-weight:700;cursor:pointer}
 #backBtn:hover{background:#3d4e9e}
 #statusLine{position:fixed;top:64px;left:0;right:0;z-index:20;text-align:center;pointer-events:none;font-size:22px;font-weight:800;color:#fff;text-shadow:0 2px 8px rgba(0,0,0,.6)}
 #statusLine .cmp{font-size:30px;padding:0 6px}
 #formula{position:fixed;bottom:150px;left:0;right:0;z-index:20;text-align:center;pointer-events:none;font-size:26px;font-weight:800;color:#9ee6ff;text-shadow:0 2px 8px rgba(0,0,0,.7)}
 #toast{position:fixed;top:38%;left:0;right:0;z-index:30;text-align:center;pointer-events:none;font-size:34px;font-weight:900;color:#ffd75e;text-shadow:0 3px 12px rgba(0,0,0,.8);opacity:0;transition:opacity .35s}
 #toast.show{opacity:1}
 #gameUI{position:fixed;bottom:14px;left:0;right:0;z-index:20;display:flex;flex-wrap:wrap;justify-content:center;gap:10px;padding:8px 12px;pointer-events:none}
 #gameUI&gt;*{pointer-events:auto}
 .gbtn{background:linear-gradient(#5b6fc0,#3d4e9e);color:#fff;border:2px solid #8fa2e8;border-radius:14px;padding:14px 20px;font-size:20px;font-weight:800;cursor:pointer;min-width:70px;box-shadow:0 4px 12px rgba(0,0,0,.4)}
 .gbtn:hover{filter:brightness(1.15)}
 .gbtn:active{transform:translateY(2px)}
 .gbtn.gold{background:linear-gradient(#e8a33d,#c47e14);border-color:#ffd98a;color:#3a2500}
 .gbtn.red{background:linear-gradient(#d96a5a,#b3452f);border-color:#f0a08f}
 .gbtn.green{background:linear-gradient(#4fae6d,#2f8a4c);border-color:#8fd8a8}
 .gbtn.small{font-size:16px;padding:10px 14px;min-width:54px}
 .gbtn.tiny{font-size:14px;padding:8px 10px;min-width:44px;border-radius:10px}
 .gbtn:disabled{opacity:.4;pointer-events:none}
 .gmsg{background:rgba(10,14,31,.78);border:1px solid rgba(255,255,255,.25);color:#fff;border-radius:14px;padding:10px 18px;font-size:18px;font-weight:700;backdrop-filter:blur(4px)}
 .gmsg b{color:#ffd75e}
 .grow{flex-basis:100%;height:0}
 #fade{position:fixed;inset:0;background:#0a0e1f;opacity:0;pointer-events:none;z-index:40;transition:opacity .5s}
 #fade.on{opacity:1;pointer-events:auto}
 .overlay{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;background:rgba(5,8,20,.78);backdrop-filter:blur(6px)}
 .overlay.hidden{display:none}
 .card{background:linear-gradient(#232c55,#151d3d);border:2px solid #5b6fc0;border-radius:24px;padding:34px 44px;max-width:680px;text-align:center;box-shadow:0 18px 60px rgba(0,0,0,.6)}
 .card h1{color:#ffd75e;font-size:40px;margin:0 0 6px;letter-spacing:2px}
 .card h2{color:#fff;font-size:22px;margin:0 0 16px;font-weight:600}
 .card p{color:#c7d2f5;font-size:16px;line-height:1.8;margin:4px 0}
 .card .sub{color:#8fa2e8;font-size:14px;line-height:1.7;margin:8px 0}
 .row{display:flex;justify-content:center;gap:12px;margin:18px 0 8px;flex-wrap:wrap}
 .lvlBtn{background:#2f3b68;color:#fff;border:2px solid #5b6fc0;border-radius:14px;padding:12px 22px;font-size:20px;font-weight:800;cursor:pointer}
 .lvlBtn.on{background:#e8a33d;border-color:#ffd98a;color:#3a2500}
 .bigBtn{background:linear-gradient(#e8a33d,#c47e14);color:#3a2500;border:none;border-radius:16px;padding:16px 40px;font-size:24px;font-weight:900;cursor:pointer;margin-top:8px;box-shadow:0 6px 18px rgba(0,0,0,.4)}
 .bigBtn:hover{filter:brightness(1.1)}
 .stars{font-size:44px;letter-spacing:8px;margin:6px 0}
 .stars .off{color:#3a4468}
 #ratingCard .got{color:#9ee6ff;font-size:20px;font-weight:700}
 #hintLine{font-size:14px;color:#8fa2e8;margin-top:10px}
&lt;/style&gt;
&lt;/head&gt;
